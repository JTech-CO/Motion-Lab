220&amp;ssl=1\" data-orig-size=\"1105,220\" data-comments-opened=\"1\" data-image-title=\"button-download\" data-image-description data-image-caption data-large-file=\"https://i0.wp.com/3dtextures.me/wp-content/uploads/2019/01/button-download.png?fit=800%2C159&amp;ssl=1\" class=\"alignnone wp-image-3138\" title src=\"https://i0.wp.com/3dtextures.me/wp-content/uploads/2019/01/button-download.png?resize=403%2C80&#038;ssl=1\" alt=\"button-download.png\" width=\"403\" height=\"80\"></noscript><img decoding=\"async\" data-attachment-id=\"3138\" data-permalink=\"https://3dtextures.me/2019/01/28/fabric-011/button-download/\" data-orig-file=\"https://i0.wp.com/3dtextures.me/wp-content/uploads/2019/01/button-download.png?fit=1105%2C220&amp;ssl=1\" data-orig-size=\"1105,220\" data-comments-opened=\"1\" data-image-title=\"button-download\" data-image-description data-image-caption data-large-file=\"https://i0.wp.com/3dtextures.me/wp-content/uploads/2019/01/button-download.png?fit=800%2C159&amp;ssl=1\" class=\"alignnone wp-image-3138 lazyload\" title src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20403%2080%22%3E%3C%2Fsvg%3E\" alt=\"button-download.png\" width=\"403\" height=\"80\" data-src=\"https://3dtextures.me/wp-content/uploads/2019/01/button-download.png\"></a></p>\n<p>If you like my work and you find it good enough to use on your work, consider giving me a small tip using the Ko-Fi button below and in return, I’ll provide you a link to the folder where I have all my textures and you can download them all with a single click.</p>\n<p><a href=\"https://ko-fi.com/N4N259VG\" target=\"_blank\" rel=\"noopener\"><noscript><img data-recalc-dims=\"1\" decoding=\"async\" data-attachment-id=\"4117\" data-permalink=\"https://3dtextures.me/2018/12/27/wood-009-mahogany/kofi5/\" data-orig-file=\"https://i0.wp.com/3dtextures.me/wp-content/uploads/2018/12/kofi5.png?fit=606%2C153&amp;ssl=1\" data-orig-size=\"606,153\" data-comment